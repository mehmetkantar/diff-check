{
  "name": "@redline/ocr",
  "version": "0.1.0",
  "description": "In-browser OCR provider for @redline/core (tesseract.js), fully self-hosted: no CDN, no network.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets": "./bin/redline-ocr-assets.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@redline/core": "0.1.0",
    "tesseract.js": "^7.0.0",
    "@tesseract.js-data/tur": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0"
  },
  "bin": {
    "redline-ocr-assets": "./bin/redline-ocr-assets.mjs"
  },
  "sideEffects": false
}
