{
  "name": "@redline/core",
  "version": "0.1.0",
  "description": "Framework-free engine that compares two versions of a DOCX or PDF document: parsing, clause-aware alignment, move detection, word-level redline and exports.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "diff": "^9.0.0",
    "docx": "^9.11.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299"
  },
  "bin": {
    "redline": "./dist/cli.js"
  }
}
